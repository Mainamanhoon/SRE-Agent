HTTP_ADDRESS=:4020
APP_ENV=development
SERVICE_VERSION=local
DATABASE_URL=postgres://sre_agent:sre_agent_local@localhost:5432/sre_agent?sslmode=disable
API_AUTH_ENABLED=true
API_AUTH_TOKEN=replace-with-at-least-32-characters
BODY_LIMIT_BYTES=1048576
REQUESTS_PER_SECOND=2000
REQUEST_BURST=4000
DATABASE_MAX_CONNECTIONS=50
DATABASE_MIN_CONNECTIONS=5
DATABASE_MAX_CONNECTION_LIFETIME=30m
