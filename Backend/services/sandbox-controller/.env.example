HTTP_ADDRESS=:4030
APP_ENV=development
SERVICE_VERSION=local
SANDBOX_NAMESPACE=sre-agent-sandboxes
SANDBOX_RUNTIME_CLASS=gvisor
SANDBOX_NODE_IMAGE=sre-agent/sandbox-node:local
SANDBOX_GO_IMAGE=sre-agent/sandbox-go:local
API_AUTH_ENABLED=true
API_AUTH_TOKEN=replace-with-at-least-32-characters
SOURCE_AUTH_TOKEN=replace-with-at-least-32-characters
BODY_LIMIT_BYTES=1048576
REQUESTS_PER_SECOND=1000
REQUEST_BURST=2000
