FROM golang:1.27.1-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sandbox-executor ./cmd/sandbox-executor

FROM node:22.22.0-bookworm-slim
RUN corepack enable
COPY --from=build /out/sandbox-executor /sandbox-executor
USER 65532:65532
ENTRYPOINT ["/sandbox-executor"]
