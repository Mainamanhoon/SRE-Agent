{
  "name": "sre-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "turbo clean",
    "stack:up": "docker compose up --build",
    "stack:down": "docker compose down",
    "observability:up": "docker compose up -d",
    "observability:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "esbuild",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
